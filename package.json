{
  "name": "polyfill-bundler",
  "version": "1.0.139",
  "description": "Polyfill service.",
  "keywords": [
    "polyfill",
    "bundle",
    "service"
  ],
  "homepage": "https://tsickert.com/polyfill-bundler",
  "license": "CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/polyfill-bundler.git"
  },
  "type": "module",
  "bin": "index.js",
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "scripts": {
    "build": "yarn build:types && yarn build:plain",
    "build:lint": "babel --presets @babel/preset-typescript --source-maps inline --out-file eslint.config.js eslint.config.ts",
    "build:plain": "babel --presets @babel/preset-env,@babel/preset-typescript --source-maps inline --out-file index.js index.ts && sed --in-place --regexp-extended 's:^// *(#![^ ]+ ).*$:\\1node:' index.js && chmod +x index.js",
    "build:types": "tsc --emitDeclarationOnly",
    "check:types": "tsc --noEmit",
    "clear": "rimraf --glob 'eslint.config.d.ts' 'index.d.ts' '*.js'",
    "lint": "yarn build:lint && eslint",
    "prepare": "yarn build",
    "serve": "./index.js",
    "start": "yarn serve",
    "update:documentation": "web-documentation"
  },
  "dependencies": {
    "clientnode": "^4.0.1533",
    "core-js": "^3.51.0",
    "polyfill-library": "^4.8.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.3",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/eslint": "^9.6.1",
    "@types/polyfill-library": "^3.108.4",
    "@typescript-eslint/parser": "^8.74.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "rimraf": "^6.1.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0",
    "web-documentation": "^2.0.0"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ],
    "tagline": "Self-hosted polyfill service serving only what each browser needs."
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
