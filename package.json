{
  "name": "polyfill-bundler",
  "version": "1.0.132",
  "description": "Polyfill service.",
  "keywords": [
    "polyfill",
    "bundle",
    "service"
  ],
  "homepage": "https://torben.website/polyfill-bundler",
  "license": "CC-BY-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/thaibault/polyfill-bundler"
  },
  "type": "module",
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "scripts": {
    "build": "yarn build:types; yarn build:plain",
    "build:lint": "babel --presets @babel/preset-typescript --source-maps inline --out-file eslint.config.js eslint.config.ts",
    "build:plain": "babel --presets @babel/preset-env,@babel/preset-typescript --source-maps inline --out-file index.js index.ts && sed --in-place --regexp-extended 's:^// *(#![^ ]+ ).*$:\\1node:' index.js && chmod +x index.js",
    "build:types": "tsc --emitDeclarationOnly",
    "check:types": "tsc --noEmit",
    "clear": "rimraf --glob 'eslint.config.d.ts' 'index.d.ts' '*.js'",
    "lint": "yarn build:lint && eslint",
    "serve": "./index.js",
    "start": "yarn serve",
    "update:documentation": "web-documentation"
  },
  "dependencies": {
    "clientnode": "^4.0.1501",
    "polyfill-library": "^4.8.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/eslint": "^9.6.1",
    "@types/polyfill-library": "^3.108.4",
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.1",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "web-documentation": "^1.0.52"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "languages": [
      "deDE",
      "enUS"
    ],
    "tagline": "",
    "trackingCode": ""
  },
  "packageManager": "yarn@4.18.0"
}
