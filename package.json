{
  "name": "polyfill-bundler",
  "version": "1.0.136",
  "description": "Polyfill service.",
  "keywords": [
    "polyfill",
    "bundle",
    "service"
  ],
  "homepage": "https://tsickert.com/polyfill-bundler",
  "license": "CC-BY-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/thaibault/polyfill-bundler"
  },
  "type": "module",
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "scripts": {
    "build": "yarn build:types && yarn build:plain",
    "build:lint": "babel --presets @babel/preset-typescript --source-maps inline --out-file eslint.config.js eslint.config.ts",
    "build:plain": "babel --presets @babel/preset-env,@babel/preset-typescript --source-maps inline --out-file index.js index.ts && sed --in-place --regexp-extended 's:^// *(#![^ ]+ ).*$:\\1node:' index.js && chmod +x index.js",
    "build:types": "tsc --emitDeclarationOnly",
    "check:types": "tsc --noEmit",
    "clear": "rimraf --glob 'eslint.config.d.ts' 'index.d.ts' '*.js'",
    "lint": "yarn build:lint && eslint",
    "serve": "./index.js",
    "start": "yarn serve",
    "update:documentation": "web-documentation"
  },
  "dependencies": {
    "clientnode": "^4.0.1524",
    "polyfill-library": "^4.8.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/eslint": "^9.6.1",
    "@types/polyfill-library": "^3.108.4",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "web-documentation": "^1.0.64"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "languages": [
      "deDE",
      "enUS"
    ],
    "tagline": "",
    "trackingCode": ""
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
